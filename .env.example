# Copy to .env for docker compose. Never commit the real file.
APP_URL=https://briefcast.example.com
POSTGRES_PASSWORD=change-me

# Shared between web (signs) and api (verifies). openssl rand -hex 32
BACKEND_JWT_SECRET=
# Auth.js. openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Agent
LLM_API_KEY=            # OpenRouter key
LLM_MODEL=anthropic/claude-sonnet-5.5
TAVILY_API_KEY=
GNANI_API_KEY=

# Brevo SMTP (SMTP_PASSWORD also works in place of SMTP_KEY)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_KEY=
MAIL_FROM=Briefcast <briefcast@example.com>
